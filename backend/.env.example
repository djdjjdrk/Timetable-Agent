# Copy to .env and replace the placeholders. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://db_user:db_password@localhost:5432/timetable_agent
JWT_SECRET_KEY=replace_with_your_own_random_secret_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Leave the key empty to run the application without AI chat.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-flash
AGENT_RECURSION_LIMIT=14

# Bind the MCP service to localhost for local development.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp

EMBEDDING_API_KEY=替换为你的向量模型密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_COLLECTION=course_docs
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002